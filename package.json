{
  "name": "quiz-game",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "start:mock": "ng serve --configuration mock",
    "start:emulator": "ng serve --configuration emulator",
    "firebase:emulators": "firebase emulators:start --project demo-quiz-game --only auth,firestore",
    "firebase:seed": "node scripts/seed-firestore.mjs",
    "firebase:rules": "node scripts/deploy-firestore-rules.mjs",
    "firebase:verify": "node scripts/verify-firebase.mjs",
    "firebase:admin": "node scripts/bootstrap-admin.mjs",
    "test:firebase": "firebase emulators:exec --project demo-quiz-game --only auth,firestore \"node scripts/run-firebase-tests.mjs\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "firebase": "^13.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
